    "ui": "pnpm sync:demo && node demo/serve.mjs"
  },
  "dependencies": {
    "@polytrade-edge/core": "file:sdk"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  }
}
